{
    "rule_sets": [
        {
        "name" : "Dir_A-Decay",
        "rules": [
                {
                    "path": "/*", 
                    "age" : {
                        "days" : 0,
                        "hours" : 0,
                        "minutes": 0,
                        "seconds": 10
                    }, 
                    "include" : true,
                    "access_frequency": 1
                },
                {
                    "path": "/move/*", 
                    "age" : {
                        "days" : 0,
                        "hours" : 0,
                        "minutes": 5,
                        "seconds": 0
                    }, 
                    "include" : true,
                    "access_frequency": 1
                },
                {
                    "path": "/no_move/*", 
                    "age" : {
                        "days" : 0,
                        "hours" : 0,
                        "minutes": 5,
                        "seconds": 0
                    }, 
                    "include" : false,
                    "access_frequency": 1
                },
                {
                    "path": "/no_move/move.txt", 
                    "age" : {
                        "days" : 0,
                        "hours" : 0,
                        "minutes": 5,
                        "seconds": 0
                    }, 
                    "include" : true,
                    "access_frequency": 1
                },
                {
                    "path": "/move/no_move.txt", 
                    "age" : {
                        "days" : 0,
                        "hours" : 0,
                        "minutes": 5,
                        "seconds": 0
                    }, 
                    "include" : false,
                    "access_frequency": 1
                }
            ]
        }
    ]
}